#!/bin/sh
# 变体 A：微信，去掉 FCITX_QT_USE_SYNC=1（其余与现有桌面项一致）。
#
# 检验假设：xcb 后端 + 同步 IM 让每次按键都在 UI 线程上做阻塞式 DBus 往返，
#           fcitx5 一旦短暂忙不过来，微信 UI 就整块卡住。
#
# 用法：先完全退出微信（含托盘），再 `wechat-nosync [微信参数...]`
set -eu

if pgrep -f '/opt/wechat/wechat' >/dev/null 2>&1; then
  echo "微信还在运行。先完全退出（含托盘）：pkill -f '/opt/wechat/wechat'" >&2
  exit 1
fi

export QT_QPA_PLATFORM=xcb
export QT_IM_MODULE=fcitx
export GTK_IM_MODULE=fcitx
export XMODIFIERS='@im=fcitx'
# 对比项：故意不设置 FCITX_QT_USE_SYNC
unset FCITX_QT_USE_SYNC

exec /opt/wechat/wechat "$@"
